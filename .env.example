# PRATA FAKTA — template konfigurasi (salin ke .env.local dan isi nilainya)
# Proyek Supabase: 'prata' (dipakai bersama PRATA & TASIK JAYA)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret pemicu endpoint ingestion (/api/ingestion/jalankan). Isi nilai acak
# yang panjang; samakan dengan GitHub secret PF_INGESTION_SECRET dan env
# PF_INGESTION_SECRET di Vercel.
PF_INGESTION_SECRET=

# Secret pemicu endpoint AI editorial (/api/ai/* dan terbitkan-terjadwal).
# Isi nilai acak yang panjang; samakan dengan GitHub secret PF_AI_SECRET
# dan env PF_AI_SECRET di Vercel.
PF_AI_SECRET=

# URL publik situs tanpa trailing slash (dipakai sitemap, robots, RSS,
# canonical, dan JSON-LD). Contoh: https://prata-fakta.vercel.app
# Samakan dengan GitHub secret PF_SITE_URL dan env PF_SITE_URL di Vercel.
PF_SITE_URL=

# HANYA server — jangan pernah ke frontend. Isi dari Supabase Dashboard
# -> Settings -> API (service_role key). Dipakai ingestion untuk menulis
# melewati RLS.
SUPABASE_SERVICE_ROLE_KEY=
